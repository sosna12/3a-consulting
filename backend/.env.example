# ============================================
#  3A Consulting — Backend Environment Variables
#  Copy this to .env and fill in real values
# ============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/3a_consulting?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d